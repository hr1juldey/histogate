---
import Layout from '../layouts/Layout.astro';
import LiveHero from '../components/LiveHero';
import Journey from '../components/Journey';
import { CaseStudies, GateGrid } from '../components/CaseStudies';
import { apiBase, get, type Metrics, type SiteConfig, type Sample } from '../lib/api';

// SSR: shell + all copy + measured numbers render server-side from the
// backend's server-driven config — content changes never redeploy the front end.
import siteCfgFallback from '../data/site-config.json';
const cfg = await get<SiteConfig>('/site-config.json').catch(() => siteCfgFallback as unknown as SiteConfig);
import metricsFallback from '../data/metrics.json';
const metrics = await get<Metrics>('/metrics.json').catch(() => metricsFallback as unknown as Metrics);
import samplesFallback from '../data/samples.json';
const samples = await get<Sample[]>('/samples').catch(() => samplesFallback as unknown as Sample[]);
const classes = samples.filter(s => s.id !== 'nonorm');
const m = metrics;
const ood = m.gate_checks.find(g => g.name === 'ood_auroc')?.value ?? '—';
const met = (v: number | string, l: string, tech: string, ok = false) => ({ v, l, tech, ok });
const metList = [
  met(m.crcval_f1, 'names the tissue right — a hospital it never saw', 'external macro-F1'),
  met(m.domain_f1, 'holds up on machines it never saw', 'raw multi-scanner macro-F1'),
  met(m.int8_agree, 'runs 4× cheaper, identical answers', 'int8 ≡ fp32 argmax', true),
  met(`${m.throughput} patches/s`, 'reads hundreds of patches a second', 'GPU throughput'),
  met(m.ece, 'when it says 97% sure, it is right 97% of the time', 'expected calibration error'),
  met(ood, 'the one check that fails — spotting pictures unlike its training', 'OOD AUROC · gate ≥ 0.90', false),
];
---
<Layout title="HistoGate — tissue AI that knows when it shouldn't answer" active="" apiBase={apiBase}>
  <header class="hero">
    <div class="wrap herogrid">
      <div>
        <span class="badge mono"><i></i>reads cancer tissue · tells you when it's unsure · live on this page</span>
        <h1>{cfg.product.tagline}</h1>
        <p class="lead">{cfg.product.hero_sub}</p>
        <div class="row">
          <a class="btn primary" href={cfg.product.primary_cta.href}>{cfg.product.primary_cta.label} →</a>
          <a class="btn ghost" href={cfg.product.secondary_cta.href}>{cfg.product.secondary_cta.label}</a>
        </div>
      </div>
      <LiveHero client:load />
    </div>
  </header>

  <div class="metrics"><div class="wrap">
    <div class="mhead">
      <span>Numbers come from the <a href={cfg.mlflow_base} target="_blank" rel="noopener">experiment tracker ↗</a></span>
    </div>
    <div class="mgrid">
      {metList.map((x, i) => (
        <div class={`metric ${i % 3 > 0 ? 'div' : ''} ${i >= 3 ? 'row2' : ''}`}>
          <div class={`v mono ${x.ok ? 'ok' : (i === 5 ? 'bad' : '')}`}>{x.v}</div>
          <div class="l">{x.l}</div>
          <div class="tech mono">{x.tech}</div>
        </div>
      ))}
    </div>
  </div></div>

  <div class="ticker" aria-hidden="true">
    <div class="tk">
      {[0,1].map(_ => (
        <span class="tk-run">
          <em>color-deconvolution stain physics</em> + <em>9-class expert-annotated training</em> +
          <em> temperature-calibrated confidence</em> + <em>int8 ≡ fp32 parity</em> +
          <em> 455 patches/sec</em> + <em>failures published, not hidden</em> +
          <em> open code &amp; model</em> +
        </span>
      ))}
    </div>
  </div>

  <section class="padded"><div class="wrap">
    <div class="kicker">How it was trained</div>
    <h2>Four attempts. Three failures. One that shipped.</h2>
    <p class="sub">Click a stage to see what happened and the measured numbers. Nothing here is a claim — every number comes from the real training logs.</p>
    <Journey client:load cfg={cfg} metrics={metrics} />
  </div></section>

  <section class="padded"><div class="wrap">
    <div class="kicker">Case studies</div>
    <h2>Where it broke — and what we did about it.</h2>
    <p class="sub">Click a card to open it.</p>
    <CaseStudies client:load cfg={cfg} metrics={metrics} />
  </div></section>

  <section class="padded"><div class="wrap">
    <div class="kicker">How it works</div>
    <h2>Check the picture first. Answer second.</h2>
    <div class="flow">
      <div class="card"><b>A picture goes in</b><p>A small magnified square of stained tissue — one of the examples, or one you upload.</p></div>
      <div class="card"><b>The quality check happens first</b><p>Blurry, marked, folded or unfamiliar pictures get flagged before any diagnosis — a bad picture should never produce a confident answer.</p></div>
      <div class="card"><b>The answer, with its reasons</b><p>What kind of tissue, how sure it really is, and a heat map showing exactly which parts of the picture drove the call.</p></div>
    </div>
  </div></section>

  <section class="padded dark"><div class="wrap">
    <div class="kicker">The shipping bar</div>
    <h2>Nothing ships until it passes nine checks.</h2>
    <p class="sub">{cfg.gate_note}</p>
    <GateGrid client:load metrics={metrics} />
  </div></section>

  <section class="padded"><div class="wrap">
    <div class="kicker">What it reads</div>
    <h2>Real tissue, labeled by doctors.</h2>
    <div class="classes">
      {classes.map(s => (
        <a class="cl" href="/demo"><img src={`/samples/${s.id}.png`} alt={s.why} /><span>{s.why}</span></a>
      ))}
    </div>
    <div class="who card">{cfg.who}</div>
  </div></section>
</Layout>

<style>
  .hero { padding: 80px 0 64px; }
  .herogrid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 44px; align-items: center; }
  .badge { display: inline-flex; align-items: center; gap: 8px; border: 1px solid #23252a; border-radius: 9999px;
    padding: 4px 12px; font-size: 11px; color: var(--t3); margin-bottom: 22px; }
  .badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--ok2); }
  h1 { font-size: clamp(32px, 4.6vw, 54px); font-weight: 500; letter-spacing: -1.2px; line-height: 1.08; }
  .lead { font-size: 17px; color: var(--t3); margin: 18px 0 28px; max-width: 520px; }
  .row { display: flex; gap: 12px; flex-wrap: wrap; }
  .metrics { border-top: 1px solid var(--b-subtle); border-bottom: 1px solid var(--b-subtle); background: var(--panel); }
  .mhead { padding: 14px 24px 0; font-size: 12.5px; color: var(--t4); }
  .mhead a { color: var(--accent-h); text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent-h) 40%, transparent); }
  .mhead a:hover { text-decoration-color: var(--accent-h); }
  .mgrid { display: grid; grid-template-columns: repeat(3, 1fr);
    padding: 34px 24px; }
  .metric { padding: 14px 22px; }
  .metric.div { border-left: 1px solid var(--b-subtle); }
  .metric .v { font-size: 34px; font-weight: 600; letter-spacing: -1px; }
  .metric .v.ok { color: var(--ok2); }
  .metric .v.bad { color: var(--bad); }
  .metric .l { font-size: 12.5px; color: var(--t3); margin-top: 6px; line-height: 1.45; }
  .metric .tech { font-size: 10px; color: var(--t4); margin-top: 5px; }
  .metric.row2 { border-top: 1px solid var(--b-subtle); }
  @media (max-width: 820px) {
    .mgrid { grid-template-columns: 1fr; }
    .metric.div { border-left: none; }
    .metric.row2 { border-top: none; }
    .metric { border-top: 1px solid var(--b-subtle); }
    .metric:first-child { border-top: none; }
  }
  .ticker { overflow: hidden; border-bottom: 1px solid var(--b-subtle);
    background: rgba(124,92,214,0.06); }
  .tk { display: flex; width: max-content; animation: tk 36s linear infinite; }
  .tk-run { white-space: nowrap; padding: 11px 0; font-size: 12.5px; color: var(--t3); }
  .tk em { font-style: normal; color: var(--t2); }
  @keyframes tk { to { transform: translateX(-50%); } }
  .dark { background: var(--panel); border-top: 1px solid var(--b-subtle); border-bottom: 1px solid var(--b-subtle); }
  .flow { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; margin-top: 36px; }
  .flow b { font-size: 16px; }
  .flow p { font-size: 14px; color: var(--t3); margin-top: 6px; }
  .classes { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-top: 36px; }
  .cl { border: 1px solid var(--b-std); border-radius: 8px; overflow: hidden; background: rgba(255,255,255,0.02); }
  .cl img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .cl span { display: block; padding: 10px 12px; font-size: 12.5px; color: var(--t3); }
  .who { margin-top: 32px; font-size: 15px; color: var(--t3); }
  @media (max-width: 900px) { .herogrid { grid-template-columns: 1fr; } }
</style>

<style is:global>
  .livehero { display: flex; flex-direction: column; gap: 14px; }
  .livehero .stack { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--b-std); }
  .livehero .stack img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .livehero .stack canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .readout { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 10px; justify-content: space-between;
    padding: 30px 14px 12px; font-size: 12.5px; background: linear-gradient(transparent, rgba(0,0,0,0.85)); }
  .readout .ok { color: #9de3b3; } .readout .warn { color: #e3b341; } .readout .dim { color: var(--t3); }
  .readout .lamp { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex: none; }
  .lamp.green { background: #5dbb7a; } .lamp.amber { background: #e3b341; }
  .mini-gauge { position: relative; flex: 1; min-width: 60px; max-width: 140px; height: 6px;
    border-radius: 3px; background: #202636; margin: 0 10px; }
  .mini-gauge i { position: absolute; left: 0; top: 0; height: 6px; border-radius: 3px; transition: width 0.4s; }
  .mini-gauge b { position: absolute; top: -2px; width: 2px; height: 10px; background: #e3b341; }
  .rail { display: flex; gap: 8px; }
  .rail button { padding: 0; border: 2px solid transparent; border-radius: 8px;
    overflow: hidden; opacity: 0.5; transition: opacity 0.15s, border-color 0.15s; cursor: pointer; }
  .rail button:hover { opacity: 0.85; }
  .rail button.on { border-color: var(--brand); opacity: 1; }
  .rail img { width: 54px; height: 54px; object-fit: cover; display: block; }
  .journey { display: grid; grid-template-columns: 300px 1fr; gap: 18px; margin-top: 36px; }
  .stages { display: flex; flex-direction: column; gap: 8px; }
  .stages button { display: flex; align-items: center; gap: 12px; text-align: left; padding: 13px 14px;
    border-radius: 8px; border: 1px solid var(--b-subtle); background: rgba(255,255,255,0.02); color: var(--t3); }
  .stages button:hover { color: var(--t2); }
  .stages button.on { border-color: var(--brand); color: var(--t1); background: rgba(94,106,210,0.08); }
  .stages .n { color: var(--t4); font-size: 11px; }
  .stages .t { font-size: 14px; font-weight: 500; }
  .stages .run { margin-left: auto; font-size: 10px; color: var(--t4); }
  .detail h3 { font-size: 20px; font-weight: 500; }
  .detail p { font-size: 14.5px; color: var(--t3); margin-top: 8px; }
  .detail .foot { color: var(--t2); }
  .runlink { display: inline-block; margin-top: 14px; font-size: 13px;
    color: var(--accent-h); text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent-h) 40%, transparent);
    text-underline-offset: 3px; }
  .runlink:hover { text-decoration-color: var(--accent-h); }
  .bars { margin-top: 18px; }
  .barrow { display: grid; grid-template-columns: 120px 1fr 64px; gap: 12px; align-items: center; margin: 10px 0; }
  .barrow .bl { font-size: 12.5px; color: var(--t3); text-align: right; }
  .track { height: 12px; border-radius: 6px; background: #202636; overflow: hidden; }
  .fill { height: 12px; border-radius: 6px; transition: width 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .fill.crc { background: linear-gradient(90deg, #3d7dca, var(--brand)); }
  .fill.dom { background: linear-gradient(90deg, #b85c9d, var(--hema)); }
  .bv { font-size: 13px; color: var(--t2); }
  .cases { display: flex; flex-direction: column; gap: 10px; margin-top: 36px; }
  .case .head { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; padding: 0; }
  .case .title { font-size: 15.5px; font-weight: 500; }
  .case .chev { margin-left: auto; color: var(--t3); font-size: 18px; }
  .case .body { margin-top: 14px; border-top: 1px solid var(--b-subtle); padding-top: 14px; }
  .case .body p { font-size: 14.5px; color: var(--t3); margin: 8px 0; }
  .case .lab { color: var(--t1); }
  .case .nums { color: var(--t2); font-size: 13px; }
  .gate { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 36px; }
  .gcell .name { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 500; }
  .gcell .val { font-size: 15px; margin-top: 8px; color: var(--t2); }
  .gcell .thr { font-size: 11px; color: var(--t4); margin-top: 2px; }
  .tick { width: 16px; height: 16px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; }
  .tick.ok { background: rgba(16,185,129,0.14); color: var(--ok2); }
  .tick.no { background: rgba(224,128,128,0.12); color: var(--bad); }
  @media (max-width: 820px) { .journey { grid-template-columns: 1fr; } }
</style>
