---
import Layout from '../layouts/Layout.astro';
import SlideMap from '../components/SlideMap';
import { apiBase } from '../lib/api';
---
<Layout title="HistoGate — a whole slide, every patch" active="slide" apiBase={apiBase}>
  <main class="wrap wrap-wide">
    <section class="act">
      <div class="kicker" style="margin-top:40px">The whole slide</div>
      <h1>Every patch, one verdict each.</h1>
      <p class="sub">A real Camelyon16 slide — a <b>lymph node</b>, a different organ
      than this colorectal model ever studied. Each square is one patch: colored =
      answered, outlined amber = declined — too unfamiliar to judge. Most decline here:
      the gate refusing a foreign organ, not the model failing. Click any square;
      right pane shows how familiar each patch felt. The model points;
      the pathologist decides.</p>
      <SlideMap client:load />
    </section>
  </main>
</Layout>

<style is:global>
  h1 { font-size: clamp(26px, 3.2vw, 36px); font-weight: 500; letter-spacing: -0.8px; margin: 6px 0 4px; }
  .act { padding: 52px 0; border-bottom: 1px solid var(--b-subtle); }
  .wrap-wide { max-width: 1280px; }
  .sub { font-size: 15px; color: var(--t2); max-width: 640px; line-height: 1.6; }
  .slide-sec { margin-top: 30px; display: grid; gap: 18px; }
  .guides { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .glab { font-size: 12.5px; color: var(--t4); font-weight: 600; }
  .guide { border: 1px solid var(--b-std); border-radius: 8px; padding: 6px 10px;
    background: var(--panel); color: var(--t2); font-size: 12px; cursor: pointer; }
  .guide:hover { border-color: var(--accent); color: var(--t1); }
  .sumband { display: flex; gap: 22px; align-items: center; flex-wrap: wrap;
    font-size: 13px; color: var(--t3); }
  .sumband b { font-size: 17px; color: var(--t1); }
  .sumband b.ok { color: #5dbb7a; }
  .sumband b.amb { color: #e3b341; }
  .vswitch { margin-left: auto; display: inline-flex; border: 1px solid var(--b-std);
    border-radius: 9999px; overflow: hidden; }
  .vswitch button { border: none; background: transparent; color: var(--t3);
    font-size: 12px; font-weight: 600; cursor: pointer; padding: 5px 13px; }
  .vswitch button.on { background: rgba(113, 112, 255, 0.15); color: var(--t1); }
  .vswitch button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .panes { display: grid; grid-template-columns: auto minmax(340px, 1fr);
    gap: 24px; align-items: stretch; justify-content: center; }
  .ulcap { font-size: 12px; color: var(--t4); margin: 10px 2px 0; }
  .sidecol { display: grid; gap: 16px; position: sticky; top: 16px; }
  .noclick { grid-column: 1 / -1; font-size: 13px; color: var(--t3); margin: 4px 0; }
  .pane { border: 1px solid var(--b-std); border-radius: 12px; background: var(--panel); padding: 14px; }
  .mosaicwrap { position: relative; padding: 8px; display: grid; justify-content: center; gap: 0; }
  .zoombox { position: relative; overflow: hidden; border-radius: 6px; cursor: grab;
    border: 1px solid var(--b-std); background: #0b0c0d; touch-action: none; }
  .zoombox:active { cursor: grabbing; }
  .zoomable { position: absolute; inset: 0; transform-origin: 0 0; }
  .rotwrap { position: absolute; inset: 0; transform-origin: 50% 50%; }
  .vctrl { position: absolute; top: 10px; right: 10px; z-index: 5;
    display: grid; grid-template-columns: repeat(2, 30px); gap: 4px; }
  .vctrl button { width: 30px; height: 30px; border-radius: 7px; font-size: 13px;
    border: 1px solid var(--b-std); background: rgba(15, 16, 17, 0.85);
    color: var(--t2); cursor: pointer; display: grid; place-items: center; padding: 0; }
  .vctrl button:hover { border-color: var(--accent); color: var(--t1); }
  .vctrl button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .zoomable .underlayer { width: 100%; height: 100%; object-fit: fill; display: block; }
  .vcell { position: absolute; border-radius: 2px; border-width: 2px; border-style: solid;
    cursor: pointer; padding: 0; min-width: 0; overflow: hidden; }
  .vcell .cellimg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vcell.dec { border-color: #e3b341 !important; border-style: dashed; background: transparent; }
  .vcell.fam { border-color: rgba(255, 255, 255, 0.12); }
  .vcell:hover { filter: brightness(1.3); }
  .vcell.sel { outline: 2px solid var(--accent); outline-offset: 1px; }
  .ulcap { font-size: 12px; color: var(--t4); margin: 10px 2px 0; }
  .inspector { display: grid; grid-template-columns: minmax(150px, 220px) minmax(0, 1fr);
    gap: 14px; align-items: start; }
  .inspector .itxt { display: grid; gap: 6px; align-content: start; }
  .inspector .tileimg { width: 100%; max-width: 220px; aspect-ratio: 1; object-fit: cover;
    border-radius: 8px; border: 1px solid var(--b-std); display: block; }
  .inspector .t { font-size: 12px; color: var(--t4); }
  .inspector .big { font-size: clamp(28px, 2.6vw, 40px); font-weight: 600; letter-spacing: -0.5px; margin-top: 6px; }
  .inspector .big.amber { color: #e3b341; }
  .inspector .sub2 { font-size: 15px; color: var(--t2); margin-top: 2px; }
  details.why summary { font-size: 12px; color: var(--t4); cursor: pointer; margin-top: 10px; width: max-content; }
  details.why summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  details.why p { font-size: 12.5px; color: var(--t3); margin: 6px 0 0; }
  .map-err { font-size: 14px; color: var(--t3); margin-top: 24px; }
  @media (max-width: 900px) { .panes { grid-template-columns: 1fr; }
    .inspector { grid-template-columns: 120px 1fr; }
    .inspector .tileimg { width: 120px; height: 120px; } }
</style>
