---
import Layout from '../layouts/Layout.astro';
import { get, type SiteConfig } from '../lib/api';
const cfg = await get<SiteConfig>('/site-config.json');
const a = cfg.about;
---
<Layout title="HistoGate — about" active="contact" apiBase="">
  <main class="wrap">

    <section class="hero">
      <figure class="photo">
        <img src="/hrijul.jpg" alt={a.name} />
      </figure>
      <div class="intro">
        <div class="kicker">About</div>
        <h1>{a.name}</h1>
        <p class="role">{a.role}</p>
        <p class="bio">{a.bio}</p>
        <div class="ctas">
          <a class="btn primary" href="/Hrijul_Dey_CV.pdf" target="_blank" rel="noopener">Contact</a>
        </div>
        <ul class="links">
          {a.links.map(l => (
            <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg">
      <div class="kicker">Background</div>
      <dl>
        {a.background.map(b => (
          <div class="row">
            <dt class="mono">{b.dates}</dt>
            <dd>{b.what}</dd>
          </div>
        ))}
      </dl>
    </section>

  </main>
</Layout>

<style>
  .hero { display: grid; grid-template-columns: 300px 1fr; gap: 52px; padding: 64px 0 64px; align-items: center; }
  .photo { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--b-std); }
  .photo img { display: block; width: 100%; aspect-ratio: 720 / 1280; object-fit: cover; }
  .intro h1 { font-size: clamp(30px, 3.8vw, 44px); font-weight: 500; letter-spacing: -1.2px; margin: 8px 0 4px; }
  .role { color: var(--t3); font-size: 15.5px; margin-bottom: 18px; }
  .bio { font-size: 15px; color: var(--t2); line-height: 1.65; max-width: 480px; margin-bottom: 24px; }
  .ctas { display: flex; gap: 12px; margin-bottom: 24px; }
  .ctas .btn { display: inline-flex; align-items: center; gap: 8px; }
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .links a { font-size: 13.5px; color: var(--accent-h); text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent-h) 40%, transparent);
    text-underline-offset: 3px; }
  .links a:hover { text-decoration-color: var(--accent-h); }

  .bg { padding: 30px 0 80px; border-top: 1px solid var(--b-subtle); }
  .bg dl { margin-top: 8px; }
  .bg .row { display: grid; grid-template-columns: 90px 1fr; gap: 26px;
    padding: 16px 0; border-bottom: 1px solid var(--b-subtle); }
  .bg .row:last-child { border-bottom: none; }
  .bg dt { font-size: 12px; color: var(--t4); padding-top: 3px; }
  .bg dd { font-size: 14.5px; color: var(--t3); line-height: 1.6; max-width: 680px; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; padding-top: 36px; gap: 32px; }
    .photo { max-width: 300px; }
  }
</style>
