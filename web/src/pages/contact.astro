---
import Layout from '../layouts/Layout.astro';
import { get, type SiteConfig } from '../lib/api';
const cfg = await get<SiteConfig>('/site-config.json');
const a = cfg.about;
---
<Layout title="HistoGate — who built this" active="contact" apiBase="">
  <main class="wrap">

    <!-- HERO: the full picture, with its story, next to the name -->
    <section class="hero">
      <figure class="photo">
        <img src="/hrijul.jpg" alt={`{a.name} at work`} />
        <figcaption>{a.photo_caption}</figcaption>
      </figure>
      <div class="intro">
        <div class="kicker">Who built this, and why</div>
        <h1>{a.name}</h1>
        <p class="role">{a.role}</p>
        <div class="ctas">
          <a class="btn primary" href="/Hrijul_Dey_CV.pdf" download>
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M7 1v8m0 0L3.5 5.5M7 9l3.5-3.5M2 12.5h10" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round"/></svg>
            Download the CV (PDF)</a>
        </div>
        <ul class="links">
          {a.links.map(l => (
            <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- THE STORY, told vertically -->
    <section class="story">
      <div class="kicker">The path to this site</div>
      <h2>Biotechnology degree, biomedical R&D, then agents in production.</h2>
      <ol class="timeline">
        {a.timeline.map(t => (
          <li>
            <span class="yr mono">{t.year}</span>
            <span class="dot" aria-hidden="true"></span>
            <div class="tl-body">
              <h3>{t.title} <span class="org">· {t.org}</span></h3>
              <p>{t.note}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="faith card">{a.faith}</div>
    </section>

</main>
</Layout>

<style>
  .hero { display: grid; grid-template-columns: 340px 1fr; gap: 48px; padding: 64px 0 56px; align-items: center; }
  .photo { position: relative; border-radius: 18px; overflow: hidden; border: 1px solid var(--b-std);
    box-shadow: 0 24px 70px -24px rgba(0,0,0,0.7); }
  .photo img { display: block; width: 100%; aspect-ratio: 720 / 1280; object-fit: cover; }
  .photo figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 56px 16px 14px; font-size: 12.5px;
    color: var(--t2); line-height: 1.5;
    background: linear-gradient(transparent, rgba(8,9,10,0.55) 30%, rgba(8,9,10,0.95)); }
  .intro h1 { font-size: clamp(34px, 4.4vw, 52px); font-weight: 500; letter-spacing: -1.4px; margin: 10px 0 6px; }
  .role { color: var(--t3); font-size: 16.5px; margin-bottom: 26px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 26px; }
  .ctas .btn { display: inline-flex; align-items: center; gap: 8px; }
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .links a { font-size: 14px; color: var(--accent-h); text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent-h) 40%, transparent);
    text-underline-offset: 3px; }
  .links a:hover { text-decoration-color: var(--accent-h); }

  .story { padding: 26px 0 60px; border-top: 1px solid var(--b-subtle); }
  .story h2, .cv h2 { font-size: clamp(22px, 2.6vw, 30px); font-weight: 500; letter-spacing: -0.6px;
    margin: 6px 0 30px; max-width: 640px; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li {
    display: grid;
    grid-template-columns: 76px 24px 1fr;  /* year | rail | body */
    column-gap: 14px;
  }
  /* the rail line and the dot each occupy the SAME grid cell (col 2, row 1):
     line stretches the full item height, dot pins to the top — grid geometry
     keeps them aligned, no absolute offsets, no collisions possible */
  .timeline li::before {
    content: ''; grid-column: 2; grid-row: 1;
    justify-self: center; width: 1px; height: 100%;
    background: var(--b-std);
  }
  .timeline li:last-child::before { background: linear-gradient(var(--b-std), transparent); }
  .dot {
    grid-column: 2; grid-row: 1;
    justify-self: center; align-self: start;
    width: 9px; height: 9px; margin-top: 6px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--brand);
    position: relative; z-index: 1;
  }
  .timeline li:last-child .dot { background: var(--hema); border-color: var(--hema); }
  .yr { grid-column: 1; grid-row: 1; font-size: 11.5px; color: var(--t4);
    text-align: right; padding-top: 4px; white-space: nowrap; }
  .tl-body { grid-column: 3; grid-row: 1; padding-bottom: 34px; }
  .timeline h3 { font-size: 16.5px; font-weight: 600; margin: 0 0 4px; }
  .timeline .org { font-weight: 400; color: var(--t3); font-size: 14px; }
  .timeline p { font-size: 14.5px; color: var(--t3); line-height: 1.6; margin: 0; max-width: 640px; }
  .faith { margin-top: 10px; font-size: 15.5px; color: var(--t2); line-height: 1.65; max-width: 720px; }

    color: var(--t4); margin: 30px 0 12px; }
    border-top: 1px dashed var(--b-std); flex-wrap: wrap; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 40px; }
    .photo { max-width: 340px; }
    .timeline li { grid-template-columns: 56px 20px 1fr; column-gap: 10px; }
    .yr { font-size: 10.5px; }
  }
</style>
