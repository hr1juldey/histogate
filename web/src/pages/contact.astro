---
import Layout from '../layouts/Layout.astro';
import { get, type SiteConfig } from '../lib/api';
const cfg = await get<SiteConfig>('/site-config.json');
const a = cfg.about;
---
<Layout title="HistoGate — who built this" active="contact" apiBase="">
  <main class="wrap">
    <div class="kicker" style="margin-top:56px">Who built this, and why</div>
    <div class="head">
      <div>
        <h1>{a.name}</h1>
        <p class="role">{a.role}</p>
      </div>
      <a class="btn primary" href="/Hrijul_Dey_CV.pdf" download>Download CV (PDF)</a>
    </div>

    <div class="grid">
      <div class="col">
        <h3>Why this exists</h3>
        {a.why.map(p => <p>{p}</p>)}
      </div>
      <div class="col">
        <h3>What it is</h3>
        {a.what.map(p => <p>{p}</p>)}
        <h3 style="margin-top:26px">Where everything lives</h3>
        <p class="links">
          <a href="https://github.com/hr1juldey/histogate" target="_blank" rel="noopener">GitHub — all code, all failed runs ↗</a>
          <a href="https://huggingface.co/riju279/histogate" target="_blank" rel="noopener">Hugging Face — model + artifacts ↗</a>
          <a href="/story">The story of the failures →</a>
          <a href="/demo">Try the live demo →</a>
        </p>
      </div>
    </div>

    <div class="card faith">{a.faith}</div>
  </main>
</Layout>

<style>
  h1 { font-size: clamp(28px, 3.4vw, 40px); font-weight: 500; letter-spacing: -1px; margin: 6px 0 2px; }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .role { color: var(--t3); font-size: 16px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 42px; }
  h3 { font-size: 15px; font-weight: 600; color: var(--t1); margin-bottom: 12px; }
  .col p { font-size: 15px; color: var(--t3); margin: 0 0 12px; line-height: 1.65; }
  .links { display: flex; flex-direction: column; gap: 8px; }
  .links a { color: var(--t2); font-size: 14.5px; }
  .links a:hover { color: var(--accent-h); }
  .faith { margin-top: 40px; font-size: 15px; color: var(--t3); line-height: 1.65; }
  @media (max-width: 780px) { .grid { grid-template-columns: 1fr; } }
</style>
