---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import { apiBase, get, type SiteConfig } from '../lib/api';
const cfg = await get<SiteConfig>('/site-config.json');
---
<Layout title="HistoGate — contact" active="contact" apiBase={apiBase}>
  <main class="wrap">
    <div class="kicker" style="margin-top:56px">Contact</div>
    <h1>{cfg.contact.headline}</h1>
    <p class="sub">{cfg.contact.sub}</p>
    <div class="grid">
      <ContactForm client:load />
      <aside class="links card">
        <h3>Direct</h3>
        <p><a href="https://github.com/hr1juldey/histogate" target="_blank" rel="noopener">GitHub — code, checkpoints, failures ↗</a></p>
        <p><a href="https://huggingface.co/riju279/histogate" target="_blank" rel="noopener">Hugging Face — model artifacts ↗</a></p>
        <p><a href="/demo">Live demo →</a></p>
        <p><a href="/story">The story, interactive →</a></p>
      </aside>
    </div>
  </main>
</Layout>

<style is:global>
  h1 { font-size: clamp(28px, 3.4vw, 40px); font-weight: 500; letter-spacing: -1px; margin: 6px 0 4px; }
  .grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 20px; margin-top: 36px; align-items: start; }
  .form { display: flex; flex-direction: column; gap: 16px; }
  .form label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--t3); }
  .form input, .form textarea {
    background: rgba(255,255,255,0.02); border: 1px solid var(--b-std); border-radius: 8px;
    color: var(--t1); padding: 11px 13px; font: inherit; font-size: 14.5px; }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--brand); }
  .frow { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .file span { justify-content: center; }
  .actions { display: flex; align-items: center; gap: 14px; }
  .err { color: var(--bad); font-size: 13px; }
  .sent h3 { font-size: 19px; font-weight: 500; margin-bottom: 8px; }
  .sent p { color: var(--t3); font-size: 14.5px; }
  .links h3 { font-size: 16px; font-weight: 500; margin-bottom: 12px; }
  .links p { margin: 10px 0; font-size: 14.5px; }
  .links a { color: var(--t2); }
  .links a:hover { color: var(--accent-h); }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .frow { grid-template-columns: 1fr; } }
</style>
