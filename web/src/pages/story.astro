---
import Layout from '../layouts/Layout.astro';
import StainDial from '../components/StainDial';
import { apiBase, get, type SiteConfig } from '../lib/api';
const cfg = await get<SiteConfig>('/site-config.json');
---
<Layout title="HistoGate — the story, interactive" active="story" apiBase={apiBase}>
  <main class="wrap">
    <section class="act">
      <div class="kicker" style="margin-top:40px">Act one</div>
      <h1>It learned to read tissue.</h1>
      <p class="sub">100,000 expert-annotated patches. Perfect scores on clean validation data.
      That was exactly the problem.</p>
    </section>

    <section class="act">
      <div class="kicker">Act two — interactive</div>
      <h1>Then the stain chemistry changed. Drag the dial.</h1>
      <p class="sub">One real tumor tile. The dial physically shifts its two dye concentrations
      (Beer-Lambert optics — the same physics as the training augmentation; no other image involved).
      Then see what a real raw-scanner tile from a different patient does to both models.
      Everything runs live.</p>
      <StainDial client:load />
    </section>

    <section class="act">
      <div class="kicker">Act three</div>
      <h1>Ship only what survives nine checks.</h1>
      <p class="sub">{cfg.gate_note}</p>
      <a class="btn primary" href="/demo">Try the shipped model on any patch →</a>
    </section>
  </main>
</Layout>

<style is:global>
  h1 { font-size: clamp(26px, 3.2vw, 36px); font-weight: 500; letter-spacing: -0.8px; margin: 6px 0 4px; }
  .act { padding: 52px 0; border-bottom: 1px solid var(--b-subtle); }
  .act:last-child { border: none; }
  .dial-sec { display: grid; grid-template-columns: 360px 1fr; gap: 30px; margin-top: 30px; align-items: start; }
  .dial-sec canvas { width: 340px; max-width: 100%; height: auto; border-radius: 14px;
    border: 2px solid var(--hema); display: block; }
  .cap { font-size: 13px; color: var(--t3); text-align: center; margin-top: 10px; }
  .dialbox { margin-top: 18px; padding: 16px; border: 1px solid var(--b-std); border-radius: 12px; background: var(--panel); }
  .ends { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--t3); margin-bottom: 8px; }
  .dialbox input[type='range'] { width: 100%; height: 34px; accent-color: var(--hema); }
  .rawbtn { margin-top: 10px; width: 100%; justify-content: center; }
  .models { display: grid; gap: 14px; }
  .mcard { background: var(--panel); border: 1px solid var(--b-std); border-radius: 12px; padding: 18px; }
  .mcard.bad { border-color: #4a3038; } .mcard.good { border-color: #23402b; }
  .mcard .t { font-size: 13px; color: var(--t3); }
  .mcard .row { display: flex; align-items: baseline; gap: 14px; margin-top: 4px; }
  .mcard .pct { font-size: 36px; font-weight: 600; }
  .mcard.bad .pct { color: var(--bad); } .mcard.good .pct { color: #5dbb7a; }
  .mcard .lab { font-size: 15px; font-weight: 500; }
  .mcard .bar { height: 12px; border-radius: 6px; background: #202636; margin-top: 12px; overflow: hidden; }
  .mcard .bar i { display: block; height: 12px; border-radius: 6px; transition: width 0.5s; }
  .mcard.bad .bar i { background: linear-gradient(90deg, #b85c5c, var(--bad)); }
  .mcard.good .bar i { background: linear-gradient(90deg, #3d9c63, #5dbb7a); }
  .mcard .live { font-size: 11.5px; color: var(--t4); margin-top: 6px; }
  .note { font-size: 13px; color: var(--t3); }
  @media (max-width: 860px) { .dial-sec { grid-template-columns: 1fr; } }
</style>
