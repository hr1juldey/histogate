---
import Layout from '../layouts/Layout.astro';
import StainDial from '../components/StainDial';
import { apiBase, get, type SiteConfig } from '../lib/api';
const cfg = await get<SiteConfig>('/site-config.json');
---
<Layout title="HistoGate — the story, interactive" active="story" apiBase={apiBase}>
  <main class="wrap">
    <section class="act">
      <div class="kicker" style="margin-top:40px">Act one</div>
      <h1>It learned to read tissue.</h1>
      <p class="sub">100,000 pictures of tissue, each already labeled by doctors.
      Perfect grades on its test. That was exactly the problem — the test was too easy.</p>
    </section>

    <section class="act">
      <div class="kicker">Act two — interactive</div>
      <h1>Then the stain changed. Drag the dial.</h1>
      <div class="legend" aria-hidden="true">
        <span class="lg">✓ matches the expert</span>
        <span class="lr">✗ confidently wrong — dangerous</span>
        <span class="la">— declined — safe</span>
      </div>
      <p class="sub">Two real tumor patches — different patients, different scanners.
      The dial shifts each patch's own dyes, the way a machine change does.
      Both AIs answer live as you drag. The needle under each answer is its
      familiarity gauge; the amber tick is its gate.</p>
      <StainDial client:load />
    </section>

    <section class="act">
      <div class="kicker">Act three</div>
      <h1>Nothing ships until it passes nine checks.</h1>
      <p class="sub">{cfg.gate_note}</p>
      <a class="btn primary" href="/demo">Try it on any picture →</a>
    </section>
  </main>
</Layout>

<style is:global>
  h1 { font-size: clamp(26px, 3.2vw, 36px); font-weight: 500; letter-spacing: -0.8px; margin: 6px 0 4px; }
  .act { padding: 52px 0; border-bottom: 1px solid var(--b-subtle); }
  .act:last-child { border: none; }
  .sub .lg { color: #5dbb7a; font-weight: 600; }
  .sub .lr { color: var(--bad); font-weight: 600; }
  .sub .la { color: #e3b341; font-weight: 600; }
  .legend { display: flex; gap: 10px; flex-wrap: wrap; margin: 4px 0 12px; }
  .legend span { font-size: 12.5px; font-weight: 600; border: 1px solid var(--b-std);
    border-radius: 9999px; padding: 5px 13px; }
  .legend .lg { color: #5dbb7a; border-color: #23402b; background: rgba(16,185,129,0.06); }
  .legend .lr { color: var(--bad); border-color: #4a3038; background: rgba(224,128,128,0.05); }
  .legend .la { color: #e3b341; border-color: #4a3f23; background: rgba(227,179,65,0.05); }
  .dial-sec { display: grid; grid-template-columns: 290px 1fr; gap: 30px; margin-top: 30px; align-items: start; }
  .truth { font-size: 12px; color: var(--t2); margin: 0 0 10px 0; line-height: 1.5; }
  .truth b { color: var(--t1); }
  .tilewrap { position: relative; width: 290px; max-width: 100%; border-radius: 14px;
    border: 2px solid var(--hema); overflow: hidden; }
  .tilewrap canvas:first-child { width: 100%; height: auto; display: block; }
  .tilewrap canvas + canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cap-hint { font-size: 12px; color: var(--t4); margin-top: 8px; }
  .dial-sec .cap { margin-top: 6px; }
  .score { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
  .chip { border: 1px solid var(--b-std); border-radius: 10px; padding: 12px 14px;
    display: flex; flex-direction: column; gap: 4px; background: rgba(255,255,255,0.02); }
  .chip .who { font-size: 11px; color: var(--t4); }
  .chip .call { font-size: 20px; font-weight: 700; letter-spacing: -0.5px; color: var(--t1); }
  .chip .badge { font-size: 12px; font-weight: 700; margin-top: 4px; }
  .chip.match { border-color: #23402b; background: rgba(16,185,129,0.06); }
  .chip.match .badge { color: #5dbb7a; }
  .chip.miss { border-color: #4a3038; background: rgba(224,128,128,0.05); }
  .chip.refuse { border-color: #4a3f23; background: rgba(227,179,65,0.05); }
  .chip.refuse .badge { color: #e3b341; }
  .chip.miss .badge { color: var(--bad); }
  .chip.expert .badge { color: var(--t4); font-weight: 500; }
  .cap { font-size: 13px; color: var(--t3); text-align: center; margin-top: 10px; }
  .dialbox { margin-top: 18px; padding: 16px; border: 1px solid var(--b-std); border-radius: 12px; background: var(--panel); }
  .ends { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--t3); margin-bottom: 8px; }
  .dialbox input[type='range'] { width: 100%; height: 34px; accent-color: var(--hema); }
  .rawbtn { margin-top: 10px; width: 100%; justify-content: center; }
  .tabs { display: flex; gap: 8px; margin-bottom: 10px; }
  .tabs button { flex: 1; padding: 9px 0; border-radius: 9px; border: 1px solid var(--b-std);
    background: transparent; color: var(--t3); font-weight: 600; font-size: 13px; cursor: pointer; }
  .tabs button.on { border-color: var(--hema); color: var(--t1); background: rgba(124, 92, 214, 0.12); }
  .tabs button.on.raw { border-color: #e3b341; background: rgba(227, 179, 65, 0.10); }
  .tilewrap.rawsrc { border-color: #e3b341; border-style: dashed; }
  .stamp { position: absolute; left: 8px; bottom: 8px; font-size: 10.5px; font-weight: 600;
    padding: 3px 8px; border-radius: 6px; background: rgba(8, 9, 10, 0.74); color: var(--t2);
    letter-spacing: 0.3px; pointer-events: none; }
  .zones { display: flex; height: 12px; margin-top: 2px; border-radius: 4px; overflow: hidden; }
  .zones .zr { width: 45%; background: rgba(16, 185, 129, 0.16); border-right: 1px solid rgba(16, 185, 129, 0.5); }
  .zones .zb { flex: 1; background: repeating-linear-gradient(135deg, transparent 0 5px, rgba(224, 128, 128, 0.12) 5px 10px); }
  .zlabels { display: flex; justify-content: space-between; font-size: 11px; color: var(--t4); margin-top: 3px; }
  .pend { display: flex; align-items: center; gap: 10px; padding: 8px 10px;
    border: 1px dashed var(--b-std); border-radius: 10px; font-size: 12px; color: var(--t3); }
  .pend canvas { width: 44px; height: 44px; border-radius: 6px; border: 1px solid var(--b-std); }
  .pend.on { border-color: var(--hema); color: var(--t2); }
  .mcard.dim { opacity: 0.55; }
  .bl { display: flex; justify-content: space-between; font-size: 11px; color: var(--t4); margin-top: 14px; }
  .gauge { position: relative; height: 10px; border-radius: 5px; background: #202636; margin-top: 6px; }
  .gauge i { position: absolute; left: 0; top: 0; height: 10px; border-radius: 5px; transition: width 0.4s; }
  .gauge .fband { position: absolute; left: 0; top: 0; height: 10px;
    background: rgba(16, 185, 129, 0.10); border-right: 1px solid rgba(16, 185, 129, 0.35); }
  .gauge .tick { position: absolute; top: -3px; width: 2px; height: 16px; background: #e3b341; }
  .gauge .tick em { position: absolute; bottom: 19px; left: 50%; transform: translateX(-50%);
    font-size: 10px; font-style: normal; color: #e3b341; white-space: nowrap; }
  .glabels { display: flex; justify-content: space-between; font-size: 10.5px;
    color: var(--t4); margin-top: 3px; line-height: 1.5; }
  .glabels span:first-child { text-align: left; }
  .glabels span:last-child { text-align: right; }
  .def { font-size: 12px; color: var(--t4); line-height: 1.5; margin: 0; }
  details.why summary { font-size: 12px; color: var(--t4); cursor: pointer; margin-top: 8px; width: max-content; }
  details.why summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  details.why p { font-size: 12.5px; color: var(--t3); margin: 6px 0 0; }
  .models { display: grid; gap: 14px; }
  .mcard { background: var(--panel); border: 1px solid var(--b-std); border-radius: 12px; padding: 18px; }
  .mcard.bad { border-color: #4a3038; } .mcard.good { border-color: #23402b; }
  .verdict-line { font-size: 14.5px; font-weight: 600; margin-top: 10px; }
  .mcard.right .verdict-line { color: #5dbb7a; }
  .mcard.wrong .verdict-line { color: var(--bad); }
  .mcard.ref .verdict-line { color: #e3b341; }
  .mcard .t { font-size: 13px; color: var(--t3); }
  .mcard .row { display: flex; align-items: baseline; gap: 14px; margin-top: 4px; }
  .mcard .pct { font-size: 36px; font-weight: 600; }
  .mcard.bad .pct { color: var(--bad); } .mcard.good .pct { color: #5dbb7a; }
  .mcard .lab { font-size: 15px; font-weight: 500; }
  .mcard .bar { height: 12px; border-radius: 6px; background: #202636; margin-top: 6px; overflow: hidden; }
  .mcard .bar i { display: block; height: 12px; border-radius: 6px; transition: width 0.5s; }
  .mcard.bad .bar i { background: linear-gradient(90deg, #b85c5c, var(--bad)); }
  .mcard.good .bar i { background: linear-gradient(90deg, #3d9c63, #5dbb7a); }
  .mcard .live { font-size: 11.5px; color: var(--t4); margin-top: 6px; }
  .note { font-size: 13px; color: var(--t3); }
  @media (max-width: 860px) { .dial-sec { grid-template-columns: 1fr; } }
</style>
