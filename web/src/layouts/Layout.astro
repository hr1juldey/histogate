---
import '../styles/tokens.css';
interface Props { title: string; active?: string; apiBase: string; }
const { title, active = '' } = Astro.props;
const nav = [
  { href: '/', label: 'Overview', id: '' },
  { href: '/story', label: 'Story', id: 'story' },
  { href: '/slide', label: 'Whole slide', id: 'slide' },
      { href: '/mcp', label: 'For agents', id: 'mcp' },
  { href: '/demo', label: 'Live demo', id: 'demo' },
  { href: '/contact', label: 'Who built this', id: 'contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#08090a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="announce" href="/story">
    <b>9 of 9</b> gate checks pass — the OOD gate is fixed (KNN detector)
  </a>
  <nav>
    <div class="wrap navrow">
      <a class="mark" href="/">
        <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true"><use href="/favicon.svg#_h" /></svg>
        <img src="/favicon.svg" width="22" height="22" alt="" />
        HistoGate
      </a>
      <div class="links">
        {nav.map(n => <a href={n.href} class={active === n.id ? 'on' : ''}>{n.label}</a>)}
      </div>
      <a class="gh" href="https://github.com/hr1juldey/histogate" target="_blank" rel="noopener" aria-label="HistoGate on GitHub">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        <span>GitHub</span>
      </a>
      <a class="btn primary navcta" href="/demo">Try the demo</a>
    </div>
  </nav>
  <slot />
  <footer>
    <div class="wrap footrow">
      <span class="ruo mono">Research Use Only — not for use in diagnostic procedures</span>
      <span class="src">HistoGate · every number measured, not promised</span>
    </div>
  </footer>
  <script>
    if ('serviceWorker' in navigator)
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => undefined));
  </script>
</body>
<style>
  .announce { display: block; background: var(--brand); color: #fff; text-align: center;
    font-size: 12.5px; padding: 8px 16px; text-decoration: none;
    transition: background 0.15s; }
  .announce:hover { background: var(--accent); }
  .announce b { font-weight: 600; }
  nav { position: sticky; top: 0; z-index: 40; background: rgba(8,9,10,0.82);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--b-subtle); }
  .navrow { display: flex; align-items: center; gap: 24px; height: 58px; }
  .mark { display: flex; align-items: center; gap: 9px; font-size: 14.5px; font-weight: 600; }
  .mark svg { display: none; }
  .links { display: flex; gap: 18px; margin-left: auto; }
  .links a { font-size: 13.5px; color: var(--t3); }
  .links a:hover, .links a.on { color: var(--t1); }
  .gh { display: flex; align-items: center; gap: 7px; height: 34px; padding: 0 12px;
    border: 1px solid var(--b-subtle); border-radius: 8px; font-size: 13px;
    color: var(--t3); transition: color 0.15s, border-color 0.15s, background 0.15s; }
  .gh:hover { color: var(--t1); border-color: #303338; background: rgba(255,255,255,0.03); }
  .navcta { height: 34px; padding: 0 14px; font-size: 13px; margin-left: 8px; }
  footer { border-top: 1px solid var(--b-subtle); margin-top: 40px; }
  .footrow { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap;
    align-items: center; padding-top: 26px; padding-bottom: 34px; font-size: 13px; color: var(--t4); }
  .ruo { border: 1px solid #23252a; border-radius: 9999px; padding: 5px 13px; font-size: 11px; color: var(--t3); }
  @media (max-width: 760px) {
    .links { display: none; }
    .gh span { display: none; }
    .gh { padding: 0 10px; }
    .navcta { padding: 0 12px; }
  }
</style>
</html>
